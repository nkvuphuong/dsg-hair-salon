SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
AddDefaultCharset UTF-8
DirectoryIndex index.html index.php
#php_value upload_max_filesize 100M
# Mod rewrite
RewriteEngine on
Options +FollowSymlinks
Options -Indexes

# Ezy Framework Init
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
# Prevent load assets as controller

RewriteCond %{REQUEST_URI} !^.*\.(ico|css|js|gif|jpg|jpeg|png|pdf|eot|ttf|woff|woff2|svg)$ [NC]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteRule ^ index.php [L]

## Customize
# Phuong-2017
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteRule ^billing/invoice/(.+) ?subact=download&mod=invoice&file=$1
# Loi-2017-09-21
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteRule ^favicon.ico public/favicon.ico

# Add correct content-type for fonts
<IfModule mod_mime.c>
    AddType application/javascript          js
    AddType application/vnd.ms-fontobject   eot
    AddType application/x-font-ttf          ttf ttc
    AddType font/opentype                   otf
    AddType application/x-font-woff         woff
    AddType image/svg+xml                   svg svgz
    AddEncoding gzip                        svgz
</Ifmodule>

# Auto deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/xml application/xml text/x-component
    AddOutputFilterByType DEFLATE application/xhtml+xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/x-icon image/svg+xml application/vnd.ms-fontobject application/x-font-ttf font/opentype

    #SetOutputFilter DEFLATE
    #AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript
</IfModule>

# Expires
<IfModule mod_expires.c>
    ExpiresActive on
    # 1 YEAR - doesn't change often
    <FilesMatch "\.(flv|ico|woff|svg|pdf|avi|mov|ppt|doc|mp3|wmv|wav)$">
        ExpiresDefault A31536000
    </FilesMatch>

    # 1 WEEK - possible to be changed, unlikely
    <FilesMatch "\.(jpg|jpeg|png|gif|swf)$">
        ExpiresDefault A604800
    </FilesMatch>

    # 1 WEEK - core content, changes quickly
    <FilesMatch "\.(txt|xml|js|css)$">
        ExpiresDefault A604800
    </FilesMatch>

    # NEVER CACHE - notice the extra directives
    <FilesMatch "\.(html|htm|php|cgi|pl)$">
        #Header set Cache-Control "max-age=0, private, no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Error Documents
ErrorDocument 400 /public/error/400.html
ErrorDocument 401 /public/error/401.html
ErrorDocument 403 /public/error/403.html
ErrorDocument 404 /public/error/404.html
ErrorDocument 500 /public/error/500.html
ErrorDocument 501 /public/error/501.html
ErrorDocument 503 /public/error/503.html

# Some tricks of security
<Files .ht*>
	Deny from all
</Files>
<Limit GET POST>
    #ACP Folder
    SetEnvIf Request_URI "(acp\/assets|acp\/modules|acp\/templates)/(.*)\.php" invalid_request=1

    #Main Framework
	SetEnvIf Request_URI "(assets|cache|app|kernel|language|uploads)/(.*)\.php" invalid_request=1
	SetEnvIf Request_URI "(assets|cache|app|kernel|language|tools|uploads)(.*)/$" invalid_request=1

    #Detect invalid requests
	Order allow,deny
	Allow from all
	Deny from env=invalid_request
</Limit>

